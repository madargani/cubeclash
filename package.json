{
  "name": "cubeclash",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@vercel/static-config": {
      "ajv": "^8.17.2"
    }
  }
}
